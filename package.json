{
  "name": "pixso-advanced-mcp",
  "version": "0.4.0",
  "description": "Local MCP bridge and read-only plugin for scanning Pixso layouts with AI agents.",
  "type": "module",
  "author": "pishikin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pishikin/pixso-advanced-mcp.git"
  },
  "homepage": "https://github.com/pishikin/pixso-advanced-mcp#readme",
  "bugs": {
    "url": "https://github.com/pishikin/pixso-advanced-mcp/issues"
  },
  "bin": {
    "pixso-advanced-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "pixso-plugin",
    "scripts",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts serve --transport http",
    "dev:stdio": "tsx src/index.ts serve --transport stdio",
    "start": "node dist/index.js serve --transport http",
    "start:http": "node dist/index.js serve --transport http",
    "start:stdio": "node dist/index.js serve --transport stdio",
    "doctor": "node dist/index.js doctor",
    "quickstart": "node dist/index.js quickstart",
    "metrics:pixso": "node scripts/pixso-quality-metrics.mjs",
    "print-codex-config": "node dist/index.js print-codex-config --transport http",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "keywords": [
    "pixso",
    "mcp",
    "mcp-server",
    "design-to-code",
    "ui-implementation",
    "frontend",
    "ai-agents",
    "plugin"
  ],
  "license": "MIT"
}
