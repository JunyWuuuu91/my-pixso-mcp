{
  "name": "my-pixso-mcp",
  "version": "0.1.0",
  "description": "Local MCP bridge and Pixso plugin for reading design data with AI agents.",
  "type": "module",
  "author": "JunyWuuuu91",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JunyWuuuu91/my-pixso-mcp.git"
  },
  "homepage": "https://github.com/JunyWuuuu91/my-pixso-mcp#readme",
  "bin": {
    "my-pixso-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "pixso-plugin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run plugin:build",
    "plugin:build": "esbuild pixso-plugin/plugin-src/index.ts --bundle --format=iife --target=es2017 --outfile=pixso-plugin/main.js",
    "dev": "tsx src/index.ts serve --transport http",
    "dev:stdio": "tsx src/index.ts serve --transport stdio",
    "start": "node dist/index.js serve --transport http",
    "start:stdio": "node dist/index.js serve --transport stdio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "keywords": [
    "pixso",
    "mcp",
    "mcp-server",
    "design-to-code",
    "plugin"
  ],
  "license": "MIT"
}
